# ── Local tests (scripts/test-db.sh uses standard libpq variables) ──
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
TEST_DB=grit_test

# ── Browser for E2E / PDF (optional; default = Playwright's Chromium from `npx playwright install chromium`) ──
# CHROME_PATH=/usr/bin/google-chrome

# ── Supabase (production backend) — fill in from Project Settings → API ──
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key            # safe in the browser: RLS + RPC checks enforce access
SUPABASE_SERVICE_ROLE_KEY=your-service-key # SERVER ONLY (contest-results integration). Never ship to the client.
