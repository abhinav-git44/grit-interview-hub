{
  "name": "grit-interview-hub",
  "version": "1.1.0",
  "private": true,
  "description": "GRIT Track Badge interview scheduling and badge lifecycle \u2014 prototype + Supabase backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test tests/domain.test.ts",
    "test:db": "bash scripts/test-db.sh",
    "test:e2e": "node scripts/build.mjs && node tests/e2e.mjs",
    "test:all": "npm run typecheck && npm test && npm run test:db && npm run test:e2e",
    "pdf": "node scripts/build-writeup.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
